{
  "name": "perfect-metal-erp",
  "version": "1.0.0",
  "private": true,
  "description": "PERFECT METAL — ERP Industriel de Chiffrage, Fabrication de Rideaux Métalliques & Thermolaquage au Four",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run desktop:dev",
    "web": "vite",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "desktop:dev": "npm run build:electron && concurrently -k -s first \"vite\" \"wait-on http://127.0.0.1:5174 && electron .\""
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
